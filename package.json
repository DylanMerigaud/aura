{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "description": "AURA: a cinematic aura-battle rhythm QTE game for the browser.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs && cd dist && rm -f ../aura-itch.zip && zip -qr ../aura-itch.zip .",
    "test": "vitest run",
    "test:map": "vitest run tests/map",
    "typecheck": "tsc --noEmit",
    "gen:campaign": "tsx scripts/gen-campaign.ts",
    "gen:art": "tsx scripts/gen-art.ts",
    "gen:voices": "tsx scripts/gen-voices.ts",
    "pages": "bash scripts/deploy-pages.sh",
    "sim": "tsx scripts/sim.ts",
    "snap": "tsx scripts/snap.ts",
    "evals:pacing": "tsx scripts/eval-pacing.ts"
  },
  "devDependencies": {
    "@google/genai": "^2.24.0",
    "@napi-rs/canvas": "^1.0.9",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.0",
    "node-web-audio-api": "^2.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
